# Kick Sync — copia este archivo a .env y rellena tus valores

# ── Servidor ──
PORT=3000
HOST=127.0.0.1
# URL pública de la app. En local: http://localhost:3000
# Kick no puede enviar webhooks a localhost: para probar el chat usa un túnel (ngrok, cloudflared) y pon aquí su URL
BASE_URL=http://localhost:3000

# ── App de Kick (https://kick.com/settings/developer) ──
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Owner de la plataforma (habilita /owner) ──
# Recomendado: tu ID numérico de Kick (inicia sesión en /dashboard y haz clic en tu nombre para copiarlo)
OWNER_ID=
# Solo para el primer arranque, antes de conocer tu ID. Se ignora si OWNER_ID tiene valor. Varios separados por coma
OWNER_USERNAME=

# ── YouTube (opcional) ──
# Permite leer la duración, bloquear videos no embebibles y pedir canciones por nombre
YOUTUBE_API_KEY=

# ── Datos ──
# Carpeta de db.json (tokens y colas) y backups/
DATA_DIR=./data
# Respaldos automáticos a conservar (uno al arrancar y otro cada 6 h)
BACKUP_KEEP=14
